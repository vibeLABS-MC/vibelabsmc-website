# Copy to .env for local development. Production values live in /etc/vibelabs-web/web.env.
ORIGIN=http://localhost:5173
# Postgres inside the dev server (no install). Production: postgres://...?host=/var/run/postgresql
DATABASE_URL=pglite:./.data/pglite
# 32+ random bytes as hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
# Optional in development: create an OAuth app with callback http://localhost:5173/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Your numeric GitHub user ID becomes admin on first sign-in.
ADMIN_GITHUB_IDS=
# Without SMTP_URL, development email is written to .data/outbox as JSON.
SMTP_URL=
# Leave unset in development; production points at clamd's socket.
CLAMD=
HIBP_URL=off
NOINDEX=1
