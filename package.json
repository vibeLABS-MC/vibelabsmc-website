{
	"name": "vibelabsmc-website",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && bun run build:tools",
		"build:tools": "bun build scripts/import-modrinth.ts --target=bun --packages=external --outdir=build/tools",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo \"\"",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run --project unit",
		"test:site": "vitest run --project site",
		"coverage": "vitest run --project unit --coverage",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"start": "node build/index.js",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun scripts/migrate.ts",
		"seed:demo": "node scripts/seed-demo.ts",
		"import:modrinth": "node --env-file-if-exists=.env scripts/import-modrinth.ts",
		"preview:app": "node --env-file=.env build/index.js"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.16",
		"@fontsource-variable/inter": "^5.3.0",
		"@lucide/svelte": "^1.70.0",
		"@sveltejs/adapter-node": "^6.0.2",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^26.6.6",
		"@types/nodemailer": "^8.0.2",
		"@types/qrcode": "^1.5.6",
		"@types/sanitize-html": "^2.16.2",
		"@types/yauzl": "^3.4.0",
		"@vitest/coverage-v8": "^4.1.12",
		"bits-ui": "^2.20.6",
		"drizzle-kit": "^0.31.11",
		"fflate": "^0.8.3",
		"happy-dom": "^21.0.4",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"simple-icons": "^16.37.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"packageManager": "bun@1.4.4",
	"dependencies": {
		"@node-rs/argon2": "^2.2.2",
		"drizzle-orm": "^0.45.4",
		"marked": "^18.2.0",
		"nodemailer": "^10.5.0",
		"postgres": "^4.1.1",
		"qrcode": "^1.5.4",
		"sanitize-html": "^2.18.1",
		"sharp": "^0.35.5",
		"yauzl": "^3.4.0"
	}
}
