// Cloudflare Workers static-assets site: no server code, served from Cloudflare's edge.
// vibelabsmc.com -> vibelabsmc.org and www -> apex are handled by Cloudflare Redirect
// Rules on the zones (see README), so they never reach this Worker.
{
  "name": "vibelabsmc-website",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "vibelabsmc.org", "custom_domain": true },
    { "pattern": "www.vibelabsmc.org", "custom_domain": true }
  ]
}
